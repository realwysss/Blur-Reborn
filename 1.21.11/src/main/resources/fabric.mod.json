{
	"schemaVersion": 1,
	"id": "blurreborn",
	"version": "${version}",
	"name": "Blur Reborn",
	"description": "camera motion blur that follows the real camera path, half size cheap pass, strength slider and /motionblur command. settings through mod menu and cloth config.",
	"authors": ["realwysss"],
	"contact": {"sources": "https://github.com/realwysss/Blur-Reborn"},
	"license": "All-Rights-Reserved",
	"icon": "assets/blurreborn/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.blrb.BlurClient"],
		"modmenu": ["dev.blrb.ModmenuIntgr"]
	},
	"mixins": [
		{
			"config": "blurreborn.client.mixins.json",
			"environment": "client"
		}
	],
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"fabric-command-api-v2": "*",
		"minecraft": "1.21.11",
		"java": ">=21"
	}
}
